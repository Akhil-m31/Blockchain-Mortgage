# Blockchain Configuration
VITE_CONTRACT_ADDRESS=0x...

# Contract ABI (paste your contract's ABI as a JSON string)
# This should be the complete contract ABI array
VITE_CONTRACT_ABI=[{"inputs":[],"name":"exampleFunction","outputs":[],"type":"function"}]

# IPFS / Pinata Configuration (optional, only needed if using document upload)
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_API_KEY=your_pinata_secret_key_here
